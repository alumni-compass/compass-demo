# Copy to apps/web/.env for local development, and set the same two variables in
# the Vercel project (Settings -> Environment Variables).
#
# Both are validated at BUILD time by packages/env/src/web.ts, which also rejects
# the example.convex.cloud placeholder. A missing or placeholder value fails the
# Vercel build rather than shipping a site that cannot reach its backend.

# Convex deployment URL. Ends in .convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://terrific-bird-760.convex.cloud

# The same deployment, ending in .convex.site. Used for Better Auth routes.
NEXT_PUBLIC_CONVEX_SITE_URL=https://terrific-bird-760.convex.site
