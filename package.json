{
  "name": "RIT-ALUMINI",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F @RIT-ALUMINI/backend",
    "dev:setup": "turbo run dev:setup -F @RIT-ALUMINI/backend"
  },
  "dependencies": {
    "@RIT-ALUMINI/env": "*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@RIT-ALUMINI/config": "*",
    "@types/node": "^22.20.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@12.0.1"
}
